{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/DodosPhotoSaver.csproj"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "publish",
      "command": "dotnet",
      "type": "process",
      "args": ["publish", "${workspaceFolder}/DodosPhotoSaver.csproj", "-c", "Release", "-r", "win-x64", "--self-contained", "-p:PublishSingleFile=true"],
      "problemMatcher": "$msCompile"
    }
  ]
}
